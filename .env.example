# web-player — copy to .env and adjust.

# --- administrator of the private management console ------------------------
WEB_PLAYER_ADMIN_USER=admin
WEB_PLAYER_ADMIN_PASSWORD=change-me-now

# --- where the media library lives ------------------------------------------
# The container path is fixed; this is the host path that is mounted on it.
WEB_PLAYER_MEDIA_HOST=/volume1/media
WEB_PLAYER_MEDIA_ROOT=/media

# --- host port --------------------------------------------------------------
WEB_PLAYER_PORT=8088

# --- which image to run -----------------------------------------------------
# Leave empty to build the image on the NAS (docker compose up -d --build).
# Set it to pull the image that GitHub Actions builds on every push to main:
#   docker compose pull && docker compose up -d
# The image is built for linux/amd64 (the DS918+ is x86-64).
WEB_PLAYER_IMAGE=

# --- identity ---------------------------------------------------------------
# Must match the owner of the media folder, otherwise the library cannot be
# listed. On the NAS:   stat -c '%u:%g' /volume1/media
PUID=1026
PGID=100

# --- public base URL --------------------------------------------------------
# Used to build the Enigma2 service references. Leave empty to derive it
# from the incoming request.
WEB_PLAYER_BASE_URL=http://192.168.1.10:8088

# --- transcoding ------------------------------------------------------------
# auto      = VAAPI when /dev/dri works, libx264 otherwise
# vaapi     = force VAAPI (fails loudly when the device is missing)
# software  = always libx264
WEB_PLAYER_TRANSCODE=auto

# --- downloading ------------------------------------------------------------
# redirect = the browser downloads a remote file (YouTube, a URL) straight
#           from the source; the NAS only decides whether it may be handed out
# proxy    = the NAS streams the bytes instead (needed for hosts that refuse
#           a direct browser request, and it keeps our file name)
WEB_PLAYER_DOWNLOAD_MODE=redirect

# The format yt-dlp picks for a YouTube link. The default is the best single
# file that has both audio and video — a redirect needs one URL.
WEB_PLAYER_YTDLP_FORMAT=b[ext=mp4]/b

# --- logging ----------------------------------------------------------------
# How much the application tells. Everything goes to stdout (that is what
# Portainer shows) and to the log file in the data volume.
#   DEBUG  = every request and every step
#   INFO   = what happened (the default)
#   WARNING|ERROR = only the trouble
WEB_PLAYER_LOG_LEVEL=INFO
# The log file (in the data volume, so it survives a restart). Leave empty
# to write to stdout only.
WEB_PLAYER_LOG_FILE=/config/web-player.log
# How many lines the console keeps in memory for the *Logs* tab
WEB_PLAYER_LOG_LINES=2000

# --- playback ---------------------------------------------------------------
# HLS segment length in seconds (the accuracy of a timestamp jump)
WEB_PLAYER_HLS_SEGMENT=4
# How many streams may run at the same time (per user, and in total)
WEB_PLAYER_MAX_STREAMS=3

TZ=Europe/Amsterdam
